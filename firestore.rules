rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && userExists(request.auth.uid) &&
        roleOf(request.auth.uid) == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }
    function isPumpOwner() {
      return signedIn() && userExists(request.auth.uid) &&
        roleOf(request.auth.uid) == 'pumpOwner' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerApplicationStatus == 'approved';
    }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if self(uid) || isAdmin();
      // Public client registration can only create a customer profile.
      allow create: if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.ownerApplicationStatus in ['none', 'pending'];
      // Roles and approval status are server-managed; clients cannot edit them.
      allow update: if self(uid) && onlyChanged(['name', 'phone', 'photoUrl', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /pumpOwnerApplications/{uid} {
      allow create: if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stationName is string
        && request.resource.data.stationAddress is string;
      allow read: if self(uid) || isAdmin();
      // Review writes happen only through the trusted Cloud Function (Admin SDK).
      allow update, delete: if false;
    }

    match /stations/{stationId} {
      allow read: if signedIn();
      allow create: if (isPumpOwner() || isAdmin())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.active is bool;
      allow update: if isAdmin() || (isPumpOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && onlyChanged(['name', 'address', 'pricePerKg', 'queueCount', 'availability', 'active', 'updatedAt']));
      allow delete: if isAdmin() && resource.data.ownerId == request.auth.uid;
    }

    match /tokens/{tokenId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || (isPumpOwner() && resource.data.stationOwnerId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.stationId is string
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (isPumpOwner() && resource.data.stationOwnerId == request.auth.uid) || (signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'cancelled'
        && onlyChanged(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.description is string;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
